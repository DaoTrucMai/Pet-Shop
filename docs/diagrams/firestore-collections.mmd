%% So do collection Firestore
flowchart TB
    DB[("Cloud Firestore<br/>petshop-app")] --> A1["users / { uid }"]
    DB --> A2["pets / { petId }"]
    DB --> A3["foods / { foodId }"]
    DB --> A4["categories / { catId }"]
    DB --> A5["carts / { uid }"]
    DB --> A6["orders / { orderId }"]
    DB --> A7["notifications / { notifId }"]
    DB --> A8["vouchers / { voucherId }"]
    DB --> A9["promotions / { promoId }"]
    DB --> A10["return_requests / { id }"]
    DB --> A11["addresses / { addrId }"]
    DB --> A12["banners / { id }"]
    DB --> A13["reviews / { id }"]

    A1 --> S1["sessions / { sessionId }"]
    S1 --> S2["messages / { msgId }"]
    A8 --> V1["voucher_usage / { id }"]

    classDef root fill:#F5A623,stroke:#E09010,color:#fff,font-weight:bold
    classDef leaf fill:#FFF8F2,stroke:#F5A623,color:#1A1A1A
    classDef sub  fill:#FFE4B5,stroke:#E09010,color:#1A1A1A

    class DB root
    class A1,A2,A3,A4,A5,A6,A7,A8,A9,A10,A11,A12,A13 leaf
    class S1,S2,V1 sub
